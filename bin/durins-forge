#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Consumer-aware Durin CLI bootstrap.
 *
 * Works when installed as:
 *   vendor/bin/durins-forge
 *   vendor/ereborcodeforge/durins-forge/bin/durins-forge
 * and when developing this repository via:
 *   php bin/durins-forge
 *
 * The project is resolved in bin/bootstrap.php. A path symlink or junction
 * does not make the checkout the application.
 */

require __DIR__ . '/bootstrap.php';

exit(durin_boot(__FILE__, $argv));
