{
    "name": "app/fixture-minimal",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-msgpack": "*",
        "ext-sockets": "*",
        "ereborcodeforge/mithrilphp": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "extra": {
        "mithril": {
            "kernel": "App\\Kernel",
            "eregion": "v0.3.0",
            "eregion_repo": "EreborCodeForge/eregion"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
