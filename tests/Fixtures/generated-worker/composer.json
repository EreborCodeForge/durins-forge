{
    "name": "app/fixture-worker",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-msgpack": "*",
        "ext-sockets": "*",
        "ereborcodeforge/mithrilphp": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "extra": {
        "mithril": {
            "job_kernel": "App\\JobKernel"
        }
    },
    "scripts": {
        "test": "phpunit",
        "job:work": "job-worker"
    },
    "config": {
        "sort-packages": true
    }
}
