{
  "name": "ereborcodeforge/durins-forge",
  "description": "Durin’s Forge is the official framework and project forger built atop MithrilPHP — crafting applications using Clean Architecture",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "php",
    "framework",
    "installer",
    "scaffolding",
    "clean-architecture",
    "api",
    "mithrilphp",
    "erebor",
    "durin"
  ],
  "homepage": "https://github.com/EreborCodeForge/durins-forge",
  "support": {
    "source": "https://github.com/EreborCodeForge/durins-forge",
    "issues": "https://github.com/EreborCodeForge/durins-forge/issues"
  },
  "authors": [
    {
      "name": "Thales Ruppenthal",
      "email": "thales.rup@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-msgpack": "*",
    "ext-sockets": "*",
    "ereborcodeforge/mithrilphp": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Core/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/durin",
    "bin/durins-forge"
  ],
  "extra": {
    "mithril": {
      "kernel": "App\\Kernel",
      "eregion": "v0.3.0",
      "eregion_repo": "EreborCodeForge/eregion"
    }
  },
  "scripts": {
    "test": "phpunit",
    "link-bins": "php scripts/link-vendor-bins.php",
    "post-install-cmd": [
      "@link-bins"
    ],
    "post-update-cmd": [
      "@link-bins"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  }
}
