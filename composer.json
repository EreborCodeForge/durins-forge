{
    "name": "ereborcodeforge/durins-forge",
    "description": "Durin’s Forge is the official framework and project forger built atop MithrilPHP — crafting applications using Clean Architecture",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "framework",
        "installer",
        "scaffolding",
        "clean-architecture",
        "api",
        "mithrilphp",
        "erebor",
        "durin"
    ],
    "homepage": "https://github.com/EreborCodeForge/durins-forge",
    "support": {
        "source": "https://github.com/EreborCodeForge/durins-forge",
        "issues": "https://github.com/EreborCodeForge/durins-forge/issues"
    },
    "authors": [
        {
            "name": "Thales Ruppenthal",
            "email": "thales.rup@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../ereborcodeforge/durin-presets",
            "options": {
                "symlink": true,
                "versions": {
                    "ereborcodeforge/durin-presets": "0.1.1"
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/EreborCodeForge/durin-core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/EreborCodeForge/durin-presets"
        },
        {
            "type": "vcs",
            "url": "https://github.com/EreborCodeForge/durin-architecture"
        }
    ],
    "require": {
        "ereborcodeforge/durin-architecture": "^0.1",
        "ereborcodeforge/durin-core": "^0.1",
        "ereborcodeforge/durin-presets": "^0.1.1",
        "ereborcodeforge/mazarbul": "^1.0",
        "ereborcodeforge/mithrilphp": "^2.2",
        "ext-msgpack": "*",
        "ext-pdo": "*",
        "ext-sockets": "*",
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "EreborCodeForge\\Durin\\Forge\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EreborCodeForge\\Durin\\Forge\\Tests\\": "tests/",
            "App\\": "resources/skeleton/application/src/"
        },
        "exclude-from-classmap": [
            "/tests/Fixtures/"
        ]
    },
    "bin": [
        "bin/durin",
        "bin/durins-forge"
    ],
    "scripts": {
        "test": "phpunit",
        "link-bins": "php scripts/link-vendor-bins.php",
        "post-install-cmd": [
            "@link-bins"
        ],
        "post-update-cmd": [
            "@link-bins"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "github-protocols": [
            "https"
        ],
        "preferred-install": "dist"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
