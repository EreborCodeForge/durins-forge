APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000

# Options: mysql, sqlite
DB_CONNECTION=sqlite

# MySQL Settings (Ignored if DB_CONNECTION=sqlite)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=durins
DB_USERNAME=root
DB_PASSWORD=

# SQLite Settings (DB_FILE is read by config/database.php)
DB_FILE=database.sqlite
# SQLITE_DATABASE=storage/database.sqlite

# Remote MySQL for real I/O bench (GET /api/benchmark/data) — fill locally, do not commit secrets
DB_BENCHMARK_HOST=127.0.0.1
DB_BENCHMARK_PORT=3306
DB_BENCHMARK_DATABASE=benchmark
DB_BENCHMARK_USERNAME=
DB_BENCHMARK_PASSWORD=
DB_BENCHMARK_CHARSET=utf8mb4

FILESYSTEM_DRIVER=local
FILESYSTEM_LOCAL_ROOT=storage
FILESYSTEM_PUBLIC_ROOT=public